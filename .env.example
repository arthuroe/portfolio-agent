# Postgres connection string, e.g. from Render, Supabase, or Neon
DATABASE_URL=postgresql://user:password@host:5432/dbname

# https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key

# https://www.voyageai.com/ (free tier available, used for embeddings)
VOYAGE_API_KEY=your-voyage-key

# Comma-separated list of allowed origins for CORS, e.g. your GitHub Pages URL
ALLOWED_ORIGINS=https://yourusername.github.io
